# App
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:4002/api/v1

# CDN / Media Storage
NEXT_PUBLIC_CDN_DOMAIN=cdn.bangme.com
NEXT_PUBLIC_USE_LOCAL_UPLOAD=true  # Set to "true" for local development

# Stripe (public key only — secret key NEVER goes here)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Agora Live Streaming
NEXT_PUBLIC_AGORA_APP_ID=your_agora_app_id

# Socket.io
NEXT_PUBLIC_SOCKET_URL=http://localhost:4002

# Environment
NODE_ENV=development
