# ──────────────────────────────────────────────────────────────────────────────
# BangMe Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Backend API base URL
# Local:       http://localhost:4002/api
# Production:  https://bangme-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4002/api

# CDN / Media Storage
NEXT_PUBLIC_CDN_DOMAIN=cdn.bangme.com
NEXT_PUBLIC_USE_LOCAL_UPLOAD=true

# Stripe publishable key — get from https://dashboard.stripe.com/apikeys
# Use pk_test_... for testing, pk_live_... for production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Agora Live Streaming — get from https://console.agora.io
NEXT_PUBLIC_AGORA_APP_ID=REPLACE_ME

# Socket.IO server URL (same host as backend, no /api suffix)
# Local:       http://localhost:4002
# Production:  https://bangme-api.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4002

# Environment
NODE_ENV=development
